# ===== Obrigatórias =====
# URL do banco (Lovable Cloud) — mesma do projeto
SUPABASE_URL=https://bnbksevtmbmlirnwglqb.supabase.co

# Chave secreta do banco (service role / secret key) — NUNCA expor no frontend
SUPABASE_SECRET_KEY=

# Token compartilhado entre este worker e a loja (gere com: openssl rand -hex 32)
# O MESMO valor deve ser salvo na loja como WHATSAPP_SERVICE_TOKEN
WHATSAPP_SERVICE_TOKEN=

# ===== IA (chatbot) =====
# true para ativar respostas automáticas com IA
WHATSAPP_AI_ENABLED=true
# Sua chave da OpenAI (necessária quando a IA está ativa)
OPENAI_API_KEY=
# Modelo (opcional)
OPENAI_MODEL=gpt-4.1-mini

# ===== Opcionais =====
PORT=8787
STOREFRONT_URL=https://absolutoglamur.com.br
LOG_LEVEL=info
